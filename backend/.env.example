MODE=local
AUTH_MODE=local
DATABASE_URL=sqlite:///./.local/echo.db
# Run scripts/configure_local.py to generate private keys; never commit actual values.
ENCRYPTION_KEY=
RESEARCHER_TOKEN=
OPENAI_API_KEY=
OPENAI_KEY_FILE=
TRANSCRIPTION_MODEL=gpt-transcribe
DECISION_MODEL=gpt-4.1-mini
WHATSAPP_TEST_MODE=true
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Digits only, including country code. This is NOT the numeric phone-number ID.
WHATSAPP_DISPLAY_NUMBER=
# Copy a currently supported version from the Meta app dashboard, e.g. vNN.N.
WHATSAPP_API_VERSION=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Approved Meta test recipients, comma-separated digits including country code.
TEST_RECIPIENT_ALLOWLIST=
COMMERCIAL_ELIGIBILITY_VERIFIED=false
SUPPORT_CONTACT=the researcher who shared your invitation
PRIVACY_NOTICE_URL=
RETENTION_DAYS=7
# Production researcher authentication requires asymmetric Supabase JWT signing.
SUPABASE_URL=
SUPABASE_JWT_AUDIENCE=authenticated
APPROVED_TEMPLATES=
