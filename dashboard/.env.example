# Local-only. Use the generated backend researcher token; do not commit the real token.
ECHO_AUTH_MODE=local
ECHO_API_URL=http://127.0.0.1:8000
ECHO_RESEARCHER_TOKEN=

# For hosted/production researcher authentication, use ECHO_AUTH_MODE=supabase.
# These are public Supabase project values, never a service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
